datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  email     String   @unique
  password  String
  role      String   // "TEACHER", "STUDENT", "ADMIN"
  className String?  // e.g. "10-A", "10-B"
  rollNo    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords        AttendanceRecord[]
  assignmentsCreated       Assignment[]
  studentAssignmentStatuses StudentAssignmentStatus[]
}

model SchoolSetting {
  id                     String   @id @default("default")
  schoolName             String   @default("Apex International Academy")
  latitude               Float    @default(28.6139)
  longitude              Float    @default(77.2090)
  attendanceRadiusMeters Float    @default(200.0)
  updatedAt              DateTime @updatedAt
}

model TimetableEntry {
  id          String   @id @default(cuid())
  className   String   // "10-A", "10-B"
  dayOfWeek   String   // "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"
  period      Int      // 1 to 6
  startTime   String   // "09:00"
  endTime     String   // "09:50"
  subject     String
  teacherName String
  room        String
  updatedAt   DateTime @updatedAt

  @@unique([className, dayOfWeek, period])
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           String   // "YYYY-MM-DD"
  status         String   // "PRESENT", "ABSENT", "LATE"
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  verified       Boolean  @default(false)
  verifiedBy     String   @default("GEOLOCATION") // "GEOLOCATION", "TEACHER_OVERRIDE"
  createdAt      DateTime @default(now())

  @@unique([studentId, date])
}

model Assignment {
  id          String   @id @default(cuid())
  type        String   @default("ASSIGNMENT") // "ASSIGNMENT" or "TEST"
  className   String   // "10-A", "10-B"
  subject     String
  title       String
  description String?
  dueDate     String   // "YYYY-MM-DD"
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentStatuses StudentAssignmentStatus[]
}

model StudentAssignmentStatus {
  id           String     @id @default(cuid())
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  isDone       Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, assignmentId])
}
