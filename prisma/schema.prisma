datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  email     String   @unique
  password  String
  role      String   // "TEACHER", "STUDENT", "ADMIN"
  className String?  // e.g. "10-A", "10-B"
  rollNo    String?
  faceDescriptor String?  // JSON serialized 128-d face feature embedding
  faceImageUrl   String?  // Enrolled profile face photo data/URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords        AttendanceRecord[]
  assignmentsCreated       Assignment[]
  studentAssignmentStatuses StudentAssignmentStatus[]
  cctvPassages             CctvPassage[]
}

model SchoolSetting {
  id                     String   @id @default("default")
  schoolName             String   @default("Arka Jain University, Gamharia")
  latitude               Float    @default(22.8433)
  longitude              Float    @default(86.1024)
  attendanceRadiusMeters Float    @default(250.0)
  aiApiKey               String?
  aiProvider             String   @default("AUTO") // "GEMINI", "ANTHROPIC", "OPENAI", "LOCAL"
  updatedAt              DateTime @updatedAt
}

model TimetableEntry {
  id          String   @id @default(cuid())
  className   String   // "10-A", "10-B"
  dayOfWeek   String   // "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"
  period      Int      // 1 to 6
  startTime   String   // "09:00"
  endTime     String   // "09:50"
  subject     String
  teacherName String
  room        String
  updatedAt   DateTime @updatedAt

  @@unique([className, dayOfWeek, period])
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           String   // "YYYY-MM-DD"
  status         String   // "PRESENT", "ABSENT", "LATE"
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  passCount      Int      @default(1) // Number of times detected/passed CCTV
  firstSeenTime  String?  // e.g. "09:05:14"
  lastSeenTime   String?  // e.g. "14:22:50"
  cctvCamera     String?  // e.g. "Gate 1 Main Entrance CCTV"
  verified       Boolean  @default(false)
  verifiedBy     String   @default("GEOLOCATION") // "GEOLOCATION", "TEACHER_OVERRIDE", "CCTV_FACIAL_RECOGNITION"
  createdAt      DateTime @default(now())

  @@unique([studentId, date])
}

model CctvPassage {
  id          String   @id @default(cuid())
  studentId   String?
  student     User?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        String   // "YYYY-MM-DD"
  timestamp   DateTime @default(now())
  timeStr     String   // "09:14:22"
  cameraName  String   @default("Gate 1 Main Entrance CCTV")
  direction   String   @default("IN") // "IN", "OUT", "PASS"
  confidence  Float?
  snapshotUrl String?
  passNumber  Int      @default(1)
  status      String   @default("VERIFIED") // "VERIFIED", "UNKNOWN"
  createdAt   DateTime @default(now())
}

model CctvCamera {
  id        String   @id @default(cuid())
  name      String
  location  String
  type      String   @default("ENTRANCE") // "ENTRANCE", "HALLWAY", "CLASSROOM"
  status    String   @default("ONLINE")
  createdAt DateTime @default(now())
}

model Assignment {
  id          String   @id @default(cuid())
  type        String   @default("ASSIGNMENT") // "ASSIGNMENT" or "TEST"
  className   String   // "10-A", "10-B"
  subject     String
  title       String
  description String?
  dueDate     String   // "YYYY-MM-DD"
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentStatuses StudentAssignmentStatus[]
}

model StudentAssignmentStatus {
  id           String     @id @default(cuid())
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  isDone       Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, assignmentId])
}
